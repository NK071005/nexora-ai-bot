# ---------------------------------------------------------------------------
# NEXORA AI — environment template. Copy to ".env" at the repository root.
# Everything below is optional except SECRET_KEY in production.
# ---------------------------------------------------------------------------

APP_ENV=development
APP_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
SECRET_KEY=change-me-to-a-long-random-string
DEFAULT_TIMEZONE=Asia/Kolkata

# SQLite by default; PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://nexora:nexora@localhost:5432/nexora
DATABASE_URL=sqlite:///./backend/nexora.db

# --- AI -------------------------------------------------------------------
# Leave OPENAI_API_KEY empty to run the honest, extractive Demo Intelligence.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Set a model name to enable image generation (e.g. gpt-image-1).
IMAGE_GENERATION_MODEL=
TRANSCRIPTION_MODEL=whisper-1

# --- Live web search (Tavily or Serper) -----------------------------------
# SEARCH_PROVIDER=tavily | serper
SEARCH_PROVIDER=tavily
SEARCH_PROVIDER_API_KEY=

# --- Email (SMTP). Without this, emails are recorded as "demo", not sent. --
GMAIL_SENDER_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# --- Google OAuth (sign-in) -----------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# --- Google Calendar / Meet (service account) -----------------------------
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CALENDAR_ID=primary
GOOGLE_SHEETS_SPREADSHEET_ID=

# --- Storage / uploads -----------------------------------------------------
STORAGE_PROVIDER=local
STORAGE_DIR=
MAX_UPLOAD_SIZE_MB=20

# --- Sessions / scheduler --------------------------------------------------
SESSION_TTL_HOURS=168
ACTIVATION_TTL_HOURS=72
RESET_TTL_MINUTES=60
REQUIRE_EMAIL_VERIFICATION=false
ALLOW_DEMO_LOGIN=true
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=15
REDIS_URL=
